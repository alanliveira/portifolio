# Chave privada da API de envio. Crie em Resend > API Keys:
# https://resend.com/api-keys
RESEND_API_KEY=

# Remetente do email. O domínio deve estar verificado no Resend > Domains:
# https://resend.com/domains
RESEND_FROM_EMAIL="Portfolio Alan Oliveira <contato@alanliveira.dev>"

# Caixa de entrada que receberá as mensagens. Nunca use esta variável no client.
CONTACT_TO_EMAIL=

# Chave pública do widget. Configure como Config/Plain Text na Vercel.
# O next.config.ts a disponibiliza somente para renderizar o widget no navegador.
# Crie ou consulte em Cloudflare Dashboard > Turnstile:
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAFBUbQxW_5uO-8oU

# Chave privada usada pelo servidor para validar o token Turnstile.
# Copie-a do mesmo widget no Cloudflare Dashboard. Nunca exponha no navegador.
TURNSTILE_SECRET_KEY=

# Hostnames que o servidor aceitará em produção, separados por vírgula.
# Inclua somente domínios públicos do widget; nunca localhost nesta variável.
TURNSTILE_HOSTNAMES=portifolio-indol-six-41.vercel.app

# URL canônica pública do site.
SITE_URL=https://alanliveira.dev
